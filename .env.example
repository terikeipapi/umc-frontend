# TMDB > Settings > API > API Read Access Token (Bearer token)
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=

# Alternatively, use a TMDB v3 API key. Leave blank when using the token above.
NEXT_PUBLIC_TMDB_API_KEY=

# Local NestJS member API (separate from the TMDB API).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
